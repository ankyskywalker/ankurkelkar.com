---
import "../styles/global.css";
import BaseLayout from "./BaseLayout.astro";
import { getCollection } from "astro:content";

export interface Props {
  title: string;
  date: Date;
  description: string;
  tags?: string[];
  readTime?: string;
  part?: string;
}

const { 
  title, 
  date, 
  description, 
  tags = [], 
  readTime = "10 min read",
  part 
} = Astro.props;

// Determine current URL and path info
const currentPath = Astro.url.pathname;
const pathSegments = currentPath.split("/").filter(Boolean); // e.g. ["blog", "clickhouse", "01-intro"]
const isBlogRoute = pathSegments[0] === "blog";
const seriesName = isBlogRoute && pathSegments.length > 2 ? pathSegments[1] : null; // "clickhouse" or "databricks"

// Get and sort series posts if applicable
let seriesPosts = [];
let currentPartIdx = -1;
let progressPercent = 0;

if (seriesName && seriesName !== "eli5") {
  const allPosts = await getCollection("blog");
  seriesPosts = allPosts
    .filter((p) => !p.data.draft && p.slug.startsWith(`${seriesName}/`))
    .sort((a, b) => {
      const aNum = parseInt(a.data.part?.match(/\d+/)?.[0] || "0");
      const bNum = parseInt(b.data.part?.match(/\d+/)?.[0] || "0");
      return aNum - bNum;
    });

  // Find index of current post in the series
  currentPartIdx = seriesPosts.findIndex((p) => {
    // Match the slug suffix
    const slugParts = p.slug.split("/");
    const postSlugName = slugParts[1] || "";
    return postSlugName === pathSegments[2];
  });
  
  if (currentPartIdx !== -1 && seriesPosts.length > 0) {
    progressPercent = Math.round(((currentPartIdx + 1) / seriesPosts.length) * 100);
  }
}

const formattedSeriesTitle = (slug: string) => {
  if (slug === "clickhouse") return "ClickHouse Mastery";
  if (slug === "databricks") return "Databricks Lakehouse";
  return slug.charAt(0).toUpperCase() + slug.slice(1);
};
---

<BaseLayout title={title}>
  <div class="container mx-auto px-4 py-8 lg:py-16">
    {seriesPosts.length > 0 ? (
      // Two Column Series Layout
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 lg:gap-12 items-start">
        
        <!-- Mobile Series TOC (Collapsible Accordion) -->
        <div class="lg:hidden w-full mb-6 no-print">
          <details class="group bg-slate-900/60 border border-white/10 rounded-2xl overflow-hidden transition-all duration-300">
            <summary class="flex justify-between items-center p-4 font-bold text-gray-200 cursor-pointer list-none select-none">
              <span class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-pink-500 animate-pulse"></span>
                <span>{formattedSeriesTitle(seriesName)} Series Index</span>
              </span>
              <span class="text-pink-400 font-semibold text-sm">
                Part {currentPartIdx + 1} of {seriesPosts.length} (Tap to view all)
              </span>
            </summary>
            <div class="border-t border-white/5 bg-[#090315]/50 p-4 space-y-2">
              {seriesPosts.map((post, idx) => {
                const isActive = idx === currentPartIdx;
                return (
                  <a
                    href={`/blog/${post.slug}`}
                    class={`flex items-center justify-between p-3 rounded-xl border text-sm transition-all duration-200 ${
                      isActive 
                        ? "bg-pink-500/10 border-pink-500/30 text-pink-300 font-bold" 
                        : "bg-white/5 border-transparent text-gray-400 hover:text-white hover:bg-white/10"
                    }`}
                  >
                    <span>Part {idx + 1}: {post.data.title.replace(/^Part \d+:\s*/i, '')}</span>
                    {isActive && <span class="text-xs bg-pink-500/20 text-pink-300 px-2 py-0.5 rounded-full font-medium">Reading</span>}
                  </a>
                );
              })}
            </div>
          </details>
        </div>

        <!-- Desktop Sidebar Navigation TOC -->
        <aside class="hidden lg:block lg:col-span-1 sticky top-24 max-h-[80vh] overflow-y-auto pr-2 no-print">
          <div class="bg-slate-950/40 backdrop-blur-md rounded-2xl border border-white/5 p-6 space-y-6">
            <div>
              <h3 class="text-xs font-black uppercase tracking-widest text-indigo-400 mb-1">Tutorial Series</h3>
              <h2 class="text-lg font-black text-white">{formattedSeriesTitle(seriesName)}</h2>
            </div>
            
            <!-- Progress Tracker -->
            <div class="space-y-2">
              <div class="flex justify-between items-center text-xs text-gray-400">
                <span>Your Progress</span>
                <span class="text-pink-400 font-bold">{progressPercent}%</span>
              </div>
              <div class="w-full h-1.5 bg-white/5 rounded-full overflow-hidden">
                <div 
                  class="h-full bg-gradient-to-r from-pink-500 to-indigo-500 transition-all duration-500" 
                  style={`width: ${progressPercent}%`}
                ></div>
              </div>
            </div>

            <!-- Steps List -->
            <nav class="space-y-2.5">
              {seriesPosts.map((post, idx) => {
                const isActive = idx === currentPartIdx;
                const isPassed = idx < currentPartIdx;
                return (
                  <a
                    href={`/blog/${post.slug}`}
                    class={`group flex items-start gap-3 p-3 rounded-xl border transition-all duration-300 ${
                      isActive
                        ? "bg-pink-500/10 border-pink-500/30 text-pink-300 shadow-lg shadow-pink-500/5"
                        : "bg-transparent border-transparent text-gray-400 hover:text-gray-200 hover:bg-white/5"
                    }`}
                  >
                    <span 
                      class={`flex-shrink-0 w-6 h-6 rounded-full flex items-center justify-center font-bold text-xs border ${
                        isActive
                          ? "border-pink-500 bg-pink-500/20 text-pink-300"
                          : isPassed
                            ? "border-indigo-500 bg-indigo-500/10 text-indigo-300"
                            : "border-white/10 text-gray-500 group-hover:border-white/20"
                      }`}
                    >
                      {idx + 1}
                    </span>
                    <span class="text-sm font-medium leading-snug">
                      {post.data.title.replace(/^Part \d+:\s*/i, '')}
                    </span>
                  </a>
                );
              })}
            </nav>
          </div>
        </aside>

        <!-- Main Content Area -->
        <div class="lg:col-span-3 max-w-4xl w-full">
          <article class="bg-slate-900/40 backdrop-blur-md rounded-3xl p-6 lg:p-12 shadow-2xl border border-white/5">
            <!-- Article Header -->
            <header class="mb-10 pb-8 border-b border-white/5">
              <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-gray-400 mb-4">
                <time datetime={date.toISOString()} class="flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-pink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <span>•</span>
                <span class="flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {readTime}
                </span>
                {part && (
                  <>
                    <span>•</span>
                    <span class="px-2.5 py-0.5 rounded-full bg-pink-500/10 text-pink-300 font-bold border border-pink-500/20">{part}</span>
                  </>
                )}
              </div>
              
              <h1 class="text-3xl lg:text-5xl font-black tracking-tight text-white mb-6 leading-tight">
                {title}
              </h1>
              
              <p class="text-lg lg:text-xl text-gray-300 font-light leading-relaxed mb-6">
                {description}
              </p>

              {tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {tags.map((tag) => (
                    <span class="px-3 py-1 bg-white/5 border border-white/5 rounded-full text-xs text-gray-300 font-semibold hover:border-pink-500/30 transition-colors">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}
            </header>

            <!-- Main MDX Content Slot -->
            <div class="prose prose-invert lg:prose-xl max-w-none prose-content">
              <slot />
            </div>

            <!-- Footer Navigation -->
            <div class="flex justify-between items-center mt-12 pt-8 border-t border-white/5 no-print">
              <div>
                {currentPartIdx > 0 && (
                  <a 
                    href={`/blog/${seriesPosts[currentPartIdx - 1].slug}`}
                    class="flex flex-col text-left group hover:opacity-80 transition"
                  >
                    <span class="text-xs text-gray-500 font-bold">← PREVIOUS PART</span>
                    <span class="text-sm font-semibold text-indigo-300 group-hover:underline">Part {currentPartIdx}</span>
                  </a>
                )}
              </div>
              <a href="/blog" class="px-4 py-2 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-sm font-semibold text-gray-300 transition">
                Back to Blog Dashboard
              </a>
              <div>
                {currentPartIdx !== -1 && currentPartIdx < seriesPosts.length - 1 && (
                  <a 
                    href={`/blog/${seriesPosts[currentPartIdx + 1].slug}`}
                    class="flex flex-col text-right group hover:opacity-80 transition"
                  >
                    <span class="text-xs text-gray-500 font-bold">NEXT PART →</span>
                    <span class="text-sm font-semibold text-pink-300 group-hover:underline">Part {currentPartIdx + 2}</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        </div>

      </div>
    ) : (
      // Stand-alone Glossary / Single Column Layout (e.g. ELI5 articles)
      <article class="max-w-3xl mx-auto bg-slate-900/40 backdrop-blur-md rounded-3xl p-6 lg:p-12 shadow-2xl border border-white/5">
        <!-- Article Header -->
        <header class="mb-10 pb-8 border-b border-white/5">
          <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-gray-400 mb-4">
            <time datetime={date.toISOString()} class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-pink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <span>•</span>
            <span class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {readTime}
            </span>
            <span class="px-2.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-300 font-bold border border-indigo-500/20">ELI5 Glossary</span>
          </div>
          
          <h1 class="text-3xl lg:text-5xl font-black tracking-tight text-white mb-6 leading-tight">
            {title}
          </h1>
          
          <p class="text-lg lg:text-xl text-gray-300 font-light leading-relaxed mb-6">
            {description}
          </p>

          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="px-3 py-1 bg-white/5 border border-white/5 rounded-full text-xs text-gray-300 font-semibold hover:border-pink-500/30 transition-colors">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </header>

        <!-- Main MDX Content Slot -->
        <div class="prose prose-invert lg:prose-xl max-w-none prose-content">
          <slot />
        </div>

        <!-- Footer Navigation -->
        <div class="flex justify-between items-center mt-12 pt-8 border-t border-white/5 no-print">
          <a href="/blog" class="px-4 py-2 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-sm font-semibold text-gray-300 transition">
            ← Back to Blog Dashboard
          </a>
        </div>
      </article>
    )}
  </div>
</BaseLayout>