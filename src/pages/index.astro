---
import BaseLayout from "../layouts/BaseLayout.astro";
const siteTitle = "Ankur Kelkar – Data Engineer & Analytics Architect";
const siteDescription = "10+ years of building robust data infrastructures, pipelines, and analytical platforms.";

const techStack = [
  {
    name: "Databricks",
    desc: "Unified analytics engine, Delta Lake, Delta Live Tables (DLT), and Spark compute optimization.",
    color: "from-orange-500/20 to-red-500/20 border-orange-500/30 text-orange-400",
    icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 2L3 7L12 12L21 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <path d="M3 17L12 22L21 17" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <path d="M3 12L12 17L21 12" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
    </svg>`
  },
  {
    name: "Snowflake",
    desc: "Enterprise data warehousing, multi-cluster compute, tasks, stored procedures, and zero-copy clones.",
    color: "from-sky-500/20 to-blue-500/20 border-sky-500/30 text-sky-400",
    icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 3V21M12 3L9 6M12 3L15 6M12 21L9 18M12 21L15 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <path d="M3 12H21M3 12L6 9M3 12L6 15M21 12L18 9M21 12L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <path d="M5.64 5.64L18.36 18.36M5.64 5.64L8.47 5.64M5.64 5.64L5.64 8.47M18.36 18.36L15.53 18.36M18.36 18.36L18.36 15.53" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <path d="M18.36 5.64L5.64 18.36M18.36 5.64L18.36 8.47M18.36 5.64L15.53 5.64M5.64 18.36L5.64 15.53M5.64 18.36L8.47 18.36" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>`
  },
  {
    name: "dbt",
    desc: "Analytics engineering, dimensional modeling, incremental strategies, and mesh architectures.",
    color: "from-amber-600/20 to-orange-600/20 border-orange-600/30 text-orange-500",
    icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
      <path d="M8 8H12M8 12H16M8 16H14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>`
  },
  {
    name: "Python",
    desc: "ETL pipelines, custom extraction packages, pandas, PySpark scripting, and automated workflows.",
    color: "from-blue-600/20 to-yellow-500/20 border-yellow-500/20 text-yellow-400",
    icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 2C8.69 2 6 4.69 6 8H10V10H6C4.34 10 3 11.34 3 13C3 14.66 4.34 16 6 16H8V18C8 19.66 9.34 21 11 21C12.66 21 14 19.66 14 18V14H10V12H14C15.66 12 17 10.66 17 9C17 7.34 15.66 6 14 6H12V2" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
    </svg>`
  },
  {
    name: "AWS & Clouds",
    desc: "S3 lake architectures, Lambda serverless, SQS/SNS pipelines, EventBridge scheduler, and GCP/GCS setups.",
    color: "from-amber-500/20 to-orange-400/20 border-amber-500/30 text-amber-400",
    icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M3 15C3 15 5.5 11.5 8 11.5C10.5 11.5 11.5 13.5 13.5 13.5C15.5 13.5 17 11.5 17 11.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <path d="M12 5C8 5 4 8.5 4 13C4 16.5 6.5 19 10 19C13.5 19 15 17.5 17 16.5C19 15.5 21 15.5 21 15.5" stroke="currentColor" stroke-width="2"/>
    </svg>`
  },
  {
    name: "PostgreSQL & SQL",
    desc: "Advanced query tuning, indexing, stored procedures, execution plan analysis, and migration.",
    color: "from-indigo-600/20 to-blue-600/20 border-indigo-500/30 text-indigo-400",
    icon: `<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <ellipse cx="12" cy="5" rx="9" ry="3" stroke="currentColor" stroke-width="2"/>
      <path d="M3 5V12C3 13.66 7.03 15 12 15C16.97 15 21 13.66 21 12V5" stroke="currentColor" stroke-width="2"/>
      <path d="M3 12V19C3 20.66 7.03 22 12 22C16.97 22 21 20.66 21 19V12" stroke="currentColor" stroke-width="2"/>
    </svg>`
  }
];
---
<BaseLayout title={siteTitle}>
  
  <!-- Hero Section -->
  <section class="relative min-h-[85vh] flex flex-col justify-center items-center text-center px-4 pt-12 overflow-hidden">
    <div class="relative z-10 max-w-4xl space-y-8">
      
      <!-- Greeting Badge -->
      <div class="inline-flex mb-2 px-5 py-2 rounded-full bg-white/5 border border-white/10 animate-fade-in-up">
        <span class="text-pink-300 font-bold tracking-wider text-xs uppercase flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-pink-500 animate-pulse"></span>
          Data engineering garden
        </span>
      </div>
      
      <!-- Title -->
      <h1 class="text-5xl md:text-8xl font-black bg-clip-text text-transparent bg-gradient-to-r from-indigo-300 via-purple-300 to-pink-300 leading-none tracking-tight animate-gradient-x pb-4">
        Ankur Kelkar
      </h1>
      
      <!-- Subtitle -->
      <p class="text-xl md:text-3xl text-indigo-100 font-light tracking-wide animate-fade-in-up delay-100">
        Data Architect <span class="text-pink-400 font-normal">&</span> Analytics Engineer
      </p>
      
      <!-- Short Intro -->
      <p class="text-base md:text-lg text-gray-400 max-w-2xl mx-auto leading-relaxed animate-fade-in-up delay-200">
        {siteDescription} Over a decade of turning massive raw data into resilient, clean analytics pipelines and cost-efficient cloud infrastructures.
      </p>
      
      <!-- CTAs -->
      <div class="flex flex-wrap justify-center gap-5 mt-10 animate-fade-in-up delay-300">
        <a 
          href="/blog" 
          class="group relative px-8 py-4 rounded-2xl bg-gradient-to-r from-pink-600 to-indigo-600 text-white font-bold shadow-2xl hover:shadow-pink-500/30 hover:-translate-y-1 transition-all duration-300 overflow-hidden"
        >
          <div class="absolute inset-0 bg-white/10 group-hover:translate-x-full transition-transform duration-500 ease-out -skew-x-12 origin-left"></div>
          <span class="relative flex items-center gap-2 text-md">
            Explore Tutorials
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>
        <a 
          href="/resume" 
          class="group px-8 py-4 rounded-2xl bg-white/5 border border-white/10 text-indigo-200 hover:bg-white/10 hover:border-pink-500/40 font-bold shadow-xl hover:-translate-y-1 transition-all duration-300 backdrop-blur-sm"
        >
          <span class="group-hover:text-pink-300 transition-colors">Read Resume</span>
        </a>
      </div>
    </div>
    
    <!-- Background blobs -->
    <div class="absolute top-20 left-10 w-44 h-44 bg-purple-600/10 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-20 right-10 w-52 h-52 bg-pink-600/10 rounded-full blur-3xl animate-pulse delay-700"></div>
  </section>

  <!-- Interactive Tech Stack Showcase -->
  <section class="py-20 relative border-t border-white/5 bg-[#090315]/50">
    <div class="container mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <h2 class="text-4xl font-extrabold tracking-tight text-white">Core Technology Expertise</h2>
        <p class="text-gray-400">A look at the languages, databases, and orchestration platforms I deploy to orchestrate production analytics architectures.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {techStack.map((tech) => (
          <div class={`glass-card p-8 rounded-3xl border flex flex-col gap-5 group transition-all duration-300`}>
            <div class={`p-3 w-fit rounded-2xl bg-white/5 ${tech.color.split(' ').slice(2).join(' ')}`}>
              <Fragment set:html={tech.icon} />
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-2 group-hover:text-pink-300 transition-colors">{tech.name}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{tech.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Blog Series -->
  <section class="py-20 relative border-t border-white/5">
    <div class="container mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <h2 class="text-4xl font-extrabold tracking-tight text-white">Featured Tutorial Series</h2>
        <p class="text-gray-400">Witty, comprehensive, and documentation-cited step-by-step guides written for builders who want to master data tooling.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        
        <!-- Databricks Series Card -->
        <article class="group relative flex flex-col justify-between overflow-hidden rounded-3xl bg-slate-950/40 border border-white/5 hover:border-pink-500/40 hover:shadow-[0_0_40px_rgba(236,72,153,0.15)] transition-all duration-300 p-8">
          <div class="space-y-4">
            <span class="px-3 py-1 text-xs font-bold bg-orange-500/10 border border-orange-500/20 text-orange-400 rounded-full">New Release</span>
            <h3 class="text-2xl font-black text-white group-hover:text-pink-300 transition-colors">🚀 Databricks Lakehouse: Zero to Hero</h3>
            <p class="text-gray-400 leading-relaxed text-sm">
              Master the modern Databricks Lakehouse platform. In this 10-part guide, we cover cluster configurations, Delta table optimizations, streaming with Auto Loader, Delta Live Tables (DLT) pipelines, Unity Catalog security, and workflows scheduling.
            </p>
            <div class="flex flex-wrap gap-2 pt-2">
              <span class="px-2.5 py-0.5 rounded-md bg-white/5 text-xs text-gray-300">Delta Lake</span>
              <span class="px-2.5 py-0.5 rounded-md bg-white/5 text-xs text-gray-300">Spark SQL</span>
              <span class="px-2.5 py-0.5 rounded-md bg-white/5 text-xs text-gray-300">Unity Catalog</span>
            </div>
          </div>
          <div class="flex items-center justify-between mt-8 pt-6 border-t border-white/5">
            <span class="text-xs text-gray-500 font-bold">10-PART COMPREHENSIVE SERIES</span>
            <a href="/blog#databricks" class="inline-flex items-center text-pink-400 hover:text-pink-300 font-bold transition">
              Read Series →
            </a>
          </div>
        </article>

        <!-- ClickHouse Series Card -->
        <article class="group relative flex flex-col justify-between overflow-hidden rounded-3xl bg-slate-950/40 border border-white/5 hover:border-pink-500/40 hover:shadow-[0_0_40px_rgba(236,72,153,0.15)] transition-all duration-300 p-8">
          <div class="space-y-4">
            <span class="px-3 py-1 text-xs font-bold bg-pink-500/10 border border-pink-500/20 text-pink-400 rounded-full">Deep-Dive</span>
            <h3 class="text-2xl font-black text-white group-hover:text-pink-300 transition-colors">🚀 ClickHouse Mastery</h3>
            <p class="text-gray-400 leading-relaxed text-sm">
              Master the fastest analytical column store database on the planet. From columnar compression under the hood to index modeling with MergeTree engines, materializing views, cluster sharding, and raw query optimizations.
            </p>
            <div class="flex flex-wrap gap-2 pt-2">
              <span class="px-2.5 py-0.5 rounded-md bg-white/5 text-xs text-gray-300">OLAP</span>
              <span class="px-2.5 py-0.5 rounded-md bg-white/5 text-xs text-gray-300">MergeTree</span>
              <span class="px-2.5 py-0.5 rounded-md bg-white/5 text-xs text-gray-300">Performance</span>
            </div>
          </div>
          <div class="flex items-center justify-between mt-8 pt-6 border-t border-white/5">
            <span class="text-xs text-gray-500 font-bold">10-PART EXPANDED SERIES (10-15m READS)</span>
            <a href="/blog#clickhouse" class="inline-flex items-center text-pink-400 hover:text-pink-300 font-bold transition">
              Read Series →
            </a>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- About Me Teaser -->
  <section class="py-20 border-t border-white/5 bg-[#090315]/50">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="glass-panel rounded-3xl p-8 lg:p-12 relative overflow-hidden flex flex-col md:flex-row items-center gap-10">
        <div class="space-y-6 flex-1">
          <h2 class="text-3xl font-extrabold text-white">About Ankur</h2>
          <p class="text-gray-300 leading-relaxed text-md">
            I'm a Data Architect with over 10 years of experience designing data pipelines, data mesh architectures, and cost optimization initiatives. I have designed pipelines and data platforms for companies in travel tech, marketing tech, and healthcare analytics, achieving significant compute savings and slashing data latency.
          </p>
          <div class="flex gap-4">
            <a href="/resume" class="text-pink-400 hover:text-pink-300 font-bold inline-flex items-center gap-1">
              Read Profile & Resume →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
