---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const allPosts = await getCollection("blog");

// Filter out drafts
const publishedPosts = allPosts.filter((post) => post.data.draft !== true);

// Group posts by series (first part of the slug)
const postsBySeries = publishedPosts.reduce(
  (acc, post) => {
    const [seriesSlug] = post.slug.split("/");
    if (!acc[seriesSlug]) {
      acc[seriesSlug] = [];
    }
    acc[seriesSlug].push(post);
    return acc;
  },
  {} as Record<string, typeof publishedPosts>,
);

// Sort posts within each series by part number or date
Object.keys(postsBySeries).forEach((series) => {
  postsBySeries[series].sort((a, b) => {
    const aNum = parseInt(a.data.part?.match(/\d+/)?.[0] || "0");
    const bNum = parseInt(b.data.part?.match(/\d+/)?.[0] || "0");
    
    if (aNum !== bNum) return aNum - bNum;
    return a.data.date.valueOf() - b.data.date.valueOf();
  });
});

// Helper to format series titles
const formatSeriesTitle = (slug: string) => {
  switch (slug) {
    case "clickhouse":
      return "ClickHouse Mastery";
    case "databricks":
      return "Databricks Lakehouse: Zero to Hero";
    case "eli5":
      return "ELI5: Data Principles Explained Simply";
    default:
      return slug.charAt(0).toUpperCase() + slug.slice(1) + " Series";
  }
};

// Helper to get series description
const getSeriesDescription = (slug: string) => {
  switch (slug) {
    case "clickhouse":
      return "Master the fastest OLAP store. Deep, 10-15 minute guides on columnar storage, indexing, and sharding.";
    case "databricks":
      return "Step-by-step masterclass on Spark compute, Delta Lake, DLT pipelines, Unity Catalog, and orchestration.";
    case "eli5":
      return "Complex data engineering terms and principles broken down into funny, sarcastic, plain English analogies.";
    default:
      return "Explore my latest technical series.";
  }
};

// Helper for tags highlights
const getTagClass = (tag: string) => {
  const t = tag.toLowerCase();
  if (t === "olap" || t === "clickhouse") return "bg-pink-500/10 text-pink-400 border-pink-500/20";
  if (t === "databricks" || t === "spark") return "bg-orange-500/10 text-orange-400 border-orange-500/20";
  if (t === "architecture" || t === "delta lake") return "bg-indigo-500/10 text-indigo-400 border-indigo-500/20";
  return "bg-white/5 text-gray-400 border-white/5";
};

const pageTitle = "Data Engineering Blog & GLossary";
---

<BaseLayout title={pageTitle}>
  <div class="container mx-auto px-6 py-12 lg:py-20">
    
    <!-- Header Section -->
    <div class="text-center mb-20 space-y-6">
      <div class="inline-flex px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-bold text-indigo-300 uppercase tracking-widest">
        Ankur's Journal
      </div>
      <h1 class="text-5xl lg:text-7xl font-black bg-clip-text text-transparent bg-gradient-to-r from-pink-400 via-indigo-400 to-yellow-200 leading-none">
        Blog & ELI5 Glossary
      </h1>
      <p class="text-lg lg:text-xl text-gray-400 max-w-2xl mx-auto leading-relaxed">
        Technical deep dives and ELI5 analogies for people who actually build things. Sarcasm included free of charge.
      </p>
    </div>

    <!-- Series Sections -->
    {
      Object.entries(postsBySeries).map(([seriesSlug, posts]) => (
        <section id={seriesSlug} class="mb-24 scroll-mt-24">
          <!-- Series Header -->
          <div class="mb-10 pb-6 border-b border-white/5">
            <h2 class="text-3xl lg:text-4xl font-black text-white flex items-center gap-3">
              <span class="w-3.5 h-3.5 rounded-full bg-pink-500 shadow-[0_0_15px_rgba(236,72,153,0.5)]"></span>
              {formatSeriesTitle(seriesSlug)}
            </h2>
            <p class="text-gray-400 text-base mt-2 max-w-3xl leading-relaxed">
              {getSeriesDescription(seriesSlug)}
            </p>
          </div>

          <!-- Series Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {posts.map((post) => (
              <article class="group relative flex flex-col justify-between bg-slate-950/40 backdrop-blur-md rounded-3xl border border-white/5 hover:border-pink-500/30 hover:shadow-[0_0_30px_rgba(236,72,153,0.1)] transition-all duration-300 overflow-hidden">
                <div>
                  <!-- Cover Image -->
                  {post.data.cover && (
                    <div class="relative h-44 overflow-hidden">
                      <Image
                        src={post.data.cover}
                        alt={post.data.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-[#090315] to-transparent"></div>
                    </div>
                  )}
                  
                  <div class="p-6 space-y-4">
                    <!-- Date & Part -->
                    <div class="flex items-center justify-between text-xs text-gray-500 font-bold">
                      <time datetime={post.data.date.toISOString()}>
                        {post.data.date.toLocaleDateString("en-US", {
                          year: "numeric",
                          month: "long",
                          day: "numeric",
                        })}
                      </time>
                      {post.data.part && (
                        <span class="px-2 py-0.5 bg-pink-500/10 border border-pink-500/20 rounded-md text-pink-400 text-[10px] uppercase font-black">
                          {post.data.part}
                        </span>
                      )}
                    </div>

                    <!-- Title -->
                    <h3 class="text-xl font-bold text-white group-hover:text-pink-300 transition-colors leading-tight">
                      <a href={`/blog/${post.slug}`}>
                        {post.data.title}
                      </a>
                    </h3>

                    <!-- Description -->
                    <p class="text-gray-400 text-sm leading-relaxed line-clamp-3">
                      {post.data.description}
                    </p>

                    <!-- Tags -->
                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="flex flex-wrap gap-1.5 pt-2">
                        {post.data.tags.map((tag) => (
                          <span class={`px-2.5 py-0.5 border rounded-md text-xs font-semibold ${getTagClass(tag)}`}>
                            #{tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>

                <!-- Read Action Link -->
                <div class="p-6 pt-0 mt-4">
                  <a
                    href={`/blog/${post.slug}`}
                    class="inline-flex items-center text-sm text-pink-400 hover:text-pink-300 font-bold group-hover:translate-x-1 transition-all"
                  >
                    Read Article &rarr;
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    }

    <!-- Newsletter Glassmorphic Signup Form -->
    <section class="mt-32 max-w-4xl mx-auto">
      <div class="glass-panel rounded-3xl p-8 lg:p-16 relative overflow-hidden text-center shadow-2xl border border-white/10">
        <div class="absolute inset-0 bg-gradient-to-r from-pink-500/5 via-transparent to-indigo-500/5 pointer-events-none"></div>
        
        <div class="relative z-10 max-w-2xl mx-auto space-y-6">
          <span class="text-xs font-black uppercase tracking-widest text-pink-400">Newsletter</span>
          <h2 class="text-3xl lg:text-4xl font-extrabold text-white">Subscribe to the Garden</h2>
          <p class="text-gray-300 text-base leading-relaxed">
            Get high-value technical articles and ELI5 data analogies delivered directly to your inbox. No spam. Just real data engineering.
          </p>
          <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto pt-4" onsubmit="event.preventDefault(); alert('Subscribed! (Demo only)');">
            <input
              type="email"
              required
              placeholder="your.email@domain.com"
              class="flex-1 px-5 py-3.5 bg-slate-950/70 border border-white/10 rounded-2xl text-white placeholder-gray-500 focus:border-pink-500 focus:outline-none transition-colors text-sm"
            />
            <button
              type="submit"
              class="px-8 py-3.5 bg-gradient-to-r from-pink-600 to-indigo-600 text-white font-bold rounded-2xl hover:opacity-90 active:scale-95 transition-all shadow-lg text-sm"
            >
              Subscribe
            </button>
          </form>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
